diff --git a/os_pickup.bp b/os_pickup.bp
index 39ffd45ea262aa5b226d4a591cf58e14ab5df5fd..afa695a85701a3ee14884b23bc9c8e6ce42a357a 100644
--- a/os_pickup.bp
+++ b/os_pickup.bp
@@ -58,3 +58,35 @@ android_app_import {
         "com.android.extensions.xr",
     ],
 }
+
+// Wisdom's product partition is unusually small. Keep the standard product
+// module above for other devices, but allow Wisdom to install the same signed
+// provider from /system without changing its package identity.
+android_app_import {
+    name: "webview_system",
+    default_dev_cert: true,
+    overrides: ["webview"],
+    required: [
+        "libwebviewchromium_loader",
+        "libwebviewchromium_plat_support",
+    ],
+    arch: {
+        arm: {
+            apk: "prebuilt/arm/webview.apk",
+        },
+        arm64: {
+            apk: "prebuilt/arm64/webview.apk",
+        },
+        x86: {
+            apk: "prebuilt/x86/webview.apk",
+        },
+        x86_64: {
+            apk: "prebuilt/x86_64/webview.apk",
+        },
+    },
+    optional_uses_libs: [
+        "android.test.base",
+        "androidx.window.extensions",
+        "com.android.extensions.xr",
+    ],
+}
