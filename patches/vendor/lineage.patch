index cd13f082a08c3fd2573a2e014aab6e6baad85b2b..441e41f53b8ba54cfad57cc4ca1760f179135af0 100644
--- a/bootanimation/fit_desc.py
+++ b/bootanimation/fit_desc.py
@@ -1,5 +1,5 @@
 #!/usr/bin/env python3
-# Rewrite desc.txt so a bootanimation fits inside a device panel.
+# Rewrite desc.txt so a bootanimation fits inside or fills a device panel.
 #
 # Bootanimation draws frames at the width and height on the first line of
 # desc.txt and centers them. The PNGs stay at their authored size and are
@@ -18,7 +18,7 @@ def fit(src_w, src_h, dst_w, dst_h):
     return max(1, int(src_w * scale)), max(1, int(src_h * scale))
 
 
-def rewrite(src, dst, dst_w, dst_h):
+def rewrite(src, dst, dst_w, dst_h, mode):
     with zipfile.ZipFile(src) as zin:
         lines = zin.read("desc.txt").decode("utf-8").splitlines(keepends=True)
         replaced = False
@@ -26,7 +26,13 @@ def rewrite(src, dst, dst_w, dst_h):
         for line in lines:
             if not replaced and line.strip():
                 parts = line.split()
-                out_w, out_h = fit(int(parts[0]), int(parts[1]), dst_w, dst_h)
+                if mode == "fill":
+                    # Let bootanimation scale the authored frames across the
+                    # whole display canvas. This is useful for devices whose
+                    # aspect ratio differs from the stock animation.
+                    out_w, out_h = dst_w, dst_h
+                else:
+                    out_w, out_h = fit(int(parts[0]), int(parts[1]), dst_w, dst_h)
                 parts[0] = str(out_w)
                 parts[1] = str(out_h)
                 newline = "\n" if line.endswith("\n") else ""
@@ -51,10 +57,14 @@ def rewrite(src, dst, dst_w, dst_h):
 
 
 def main(argv):
-    if len(argv) != 5:
-        print("usage: fit_desc.py SRC.zip DST.zip WIDTH HEIGHT", file=sys.stderr)
+    if len(argv) not in (5, 6):
+        print("usage: fit_desc.py SRC.zip DST.zip WIDTH HEIGHT [fit|fill]", file=sys.stderr)
+        return 2
+    src, dst, width, height = argv[1:5]
+    mode = argv[5] if len(argv) == 6 else "fit"
+    if mode not in ("fit", "fill"):
+        print(f"mode must be 'fit' or 'fill', got {mode!r}", file=sys.stderr)
         return 2
-    src, dst, width, height = argv[1:]
     try:
         dst_w = int(width)
         dst_h = int(height)
@@ -62,7 +72,7 @@ def main(argv):
         print(f"width and height must be integers, got {width!r} {height!r}",
               file=sys.stderr)
         return 2
-    rewrite(src, dst, dst_w, dst_h)
+    rewrite(src, dst, dst_w, dst_h, mode)
     return 0
 
 
