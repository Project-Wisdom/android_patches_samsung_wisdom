+        int iconSpace = mIconTouchSize + (2 * mItemMarginLeftRight);
+        while (amountOfSpaceTaskbarIconsCanHave < taskbarIconSpaceNeeded) {
+            ignoreCount++;
+            taskbarIconSpaceNeeded -= iconSpace;
+        }
+        return Math.min(Math.max(hotseatIcons, 1) - 1, ignoreCount);
