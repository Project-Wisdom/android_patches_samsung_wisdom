+    /**
+     * Phase 2A.1 regression test:
+     * Verifies that the LineageOS 23.2 width-based calculation prevents TaskbarView from
+     * dropping the third pinned app on compact tablets in portrait with 3-button navigation.
+     */
+    @Test
+    fun compactPortrait_taskbarWidthCalculation_doesNotDropThirdApp() {
+        val density = 2.0f // 320dpi (wisdom)
+        val screenWidthPx = (600 * density).toInt() // 1200px
+        val iconTouchSizePx = (48 * density).toInt() // 96px (48dp)
+        val itemMarginPx = (8 * density).toInt() // 16px (8dp)
+        val iconSizePx = iconTouchSizePx + 2 * itemMarginPx // 128px (64dp)
+        val barEndOffsetPx = (255 * density).toInt() // 510px (255dp)
+        val allAppsOffsetPx = 0 // 0px in persistent taskbar
+
+        // Available space between screen edge and navigation buttons:
+        val amountOfSpaceTaskbarIconsCanHave = screenWidthPx - barEndOffsetPx // 690px
+
+        // Items: All Apps (1) + Divider (1) + Hotseat (3) = 5 items
+        val totalItems = 5
+        // getIconLayoutWidth(5): 5 * iconSize - 4 * itemMargin (divider) - allAppsOffset
+        val spaceNeededPx = totalItems * iconSizePx - 4 * itemMarginPx - allAppsOffsetPx // 5 * 128 - 64 - 0 = 576px
+
+        // 1. LineageOS 23.2 width-based calculation (with fixed bubble bar check):
+        var widthBasedIgnoreCount = 0
+        var neededPx = spaceNeededPx
+        while (amountOfSpaceTaskbarIconsCanHave < neededPx) {
+            widthBasedIgnoreCount++
+            neededPx -= iconSizePx
+        }
+        // In LOS 23.2 width-based path, spaceNeeded (576px) <= spaceAvailable (690px) -> ZERO icons dropped!
+        assertThat(widthBasedIgnoreCount).isEqualTo(0)
+
+        // 2. Contrast with Android 17 / Toni Barzic buggy formula:
+        // calculateMaxNumIcons() reserved double margins (510 + 150 = 660px), leaving 540px.
+        // Math.floorDiv(540 - 64 (divider) - 128 (allApps), 128) + 2 = 4 slots.
+        val buggyMaxNumIcons = 4
+        val buggyIgnoreCount = kotlin.math.max(0, 2 + 0 + 3 - buggyMaxNumIcons)
+        // Demonstrates the bug: A17 formula erroneously dropped 1 icon!
+        assertThat(buggyIgnoreCount).isEqualTo(1)
+
+        // 3. Contrast with uncorrected bubble bar check (subtracting 144px for phantom bubbles):
+        val phantomBubbleSpacePx = 144
+        val spaceWithPhantomBubbles = amountOfSpaceTaskbarIconsCanHave - phantomBubbleSpacePx // 546px
+        var phantomBubbleIgnoreCount = 0
+        var neededWithPhantom = spaceNeededPx
+        while (spaceWithPhantomBubbles < neededWithPhantom) {
+            phantomBubbleIgnoreCount++
+            neededWithPhantom -= iconSizePx
+        }
+        // Demonstrates why the initial LOS23.2 port still dropped 1 icon until getBubbleBarMaxCollapsedWidthIfVisible() was used
+        assertThat(phantomBubbleIgnoreCount).isEqualTo(1)
+    }
+
