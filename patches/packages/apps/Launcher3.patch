+    @Test
+    fun putSync_mixedBackedUpAndDeviceItems_returnsTrueAndPersistsBoth() {
+        val backedUpItem = LauncherPrefs.backedUpItem("test_putsync_backed", TEST_DEFAULT_VALUE)
+        val deviceItem = LauncherPrefs.nonRestorableItem("test_putsync_device", TEST_DEFAULT_VALUE)
+
+        with(launcherPrefs) {
+            assertThat(putSync(backedUpItem.to("backed"), deviceItem.to("device"))).isTrue()
+            assertThat(get(backedUpItem)).isEqualTo("backed")
+            assertThat(get(deviceItem)).isEqualTo("device")
+            assertThat(removeSync(backedUpItem, deviceItem)).isTrue()
+            assertThat(has(backedUpItem)).isFalse()
+            assertThat(has(deviceItem)).isFalse()
+        }
+    }
+
+    @Test
+    fun putSync_whenCommitFails_returnsFalseAndKeepsRetryableState() {
+        val backing =
+            context.getSharedPreferences("test_putsync_failing", Context.MODE_PRIVATE)
+        backing.edit().clear().commit()
+        val failingPrefs = ProxyPrefs(context, FailingCommitPrefs(backing))
+        val item = LauncherPrefs.nonRestorableItem("test_putsync_failure", TEST_DEFAULT_VALUE)
+
+        // commit() returns false: nothing is persisted and the caller is informed.
+        assertThat(failingPrefs.putSync(item.to("new_value"))).isFalse()
+        assertThat(failingPrefs.get(item)).isEqualTo(TEST_DEFAULT_VALUE)
+
+        // Retrying against healthy storage succeeds, so a failed migration stays retryable.
+        val healthyPrefs = ProxyPrefs(context, backing)
+        assertThat(healthyPrefs.putSync(item.to("new_value"))).isTrue()
+        assertThat(healthyPrefs.get(item)).isEqualTo("new_value")
+        assertThat(healthyPrefs.removeSync(item)).isTrue()
+    }
+
+    @Test
+    fun putSync_whenOnePreferenceFileCommitFails_reportsFailureAndStillCommitsOtherFile() {
+        val backedUpItem = LauncherPrefs.backedUpItem("test_putsync_partial_backed", TEST_DEFAULT_VALUE)
+        val deviceItem = LauncherPrefs.nonRestorableItem("test_putsync_partial_device", TEST_DEFAULT_VALUE)
+        val prefs = FailingBackedUpLauncherPrefs(context)
+
+        assertThat(prefs.putSync(backedUpItem.to("backed"), deviceItem.to("device"))).isFalse()
+        assertThat(prefs.get(backedUpItem)).isEqualTo(TEST_DEFAULT_VALUE)
+        assertThat(prefs.get(deviceItem)).isEqualTo("device")
+
+        // The cloud-backed state failed, so callers must not persist a local completion marker.
+        assertThat(prefs.removeSync(backedUpItem, deviceItem)).isFalse()
+        assertThat(prefs.has(backedUpItem)).isFalse()
+        assertThat(prefs.has(deviceItem)).isFalse()
+    }
+}
+
+/** Delegates to [delegate] but reports every commit as failed without persisting anything. */
+private class FailingCommitPrefs(private val delegate: SharedPreferences) :
+    SharedPreferences by delegate {
+
+    override fun edit(): SharedPreferences.Editor =
+        object : SharedPreferences.Editor by delegate.edit() {
+            override fun commit(): Boolean = false
+        }
+}
+
+private class FailingBackedUpLauncherPrefs(context: Context) : LauncherPrefs(context) {
+    override fun getSharedPrefs(item: Item): SharedPreferences {
+        val prefs = super.getSharedPrefs(item)
+        return if (item.isBackedUp) FailingCommitPrefs(prefs) else prefs
+    }
 }
