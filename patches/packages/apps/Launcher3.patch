+    /**
+     * Verifies the exact Hotseat capacity calculation with QuickStep runtime dimensions:
+     * - quickstep/res/values/dimens.xml: taskbar_button_margin_6_5 = 75dp
+     * - quickstep/res/values-land/dimens.xml: taskbar_button_margin_6_5 = 219.6dp
+     *
+     * In HotseatProfileInitialValues:
+     *   barEndOffset = navButtonsLayoutWidthPx + inlineNavButtonsEndSpacingPx
+     * In HotseatProfile.recalculateHotseatWidthAndBorderSpace:
+     *   sideSpacePx = inlineNavButtonsEndSpacingPx
+     *   maxHotseatWidthPx = availableWidthPx - sideSpacePx - barEndOffset
+     *
+     * Consequently, inlineNavButtonsEndSpacing is reserved on both sides of the 3-button group.
+     */
+    @Test
+    fun tabletCompact_capacityCalculation_withQuickstepInlineNavMargins() {
+        val density = 2.0f // 320dpi (wisdom)
+        val iconSizePx = (60 * density).toInt() // 120px (60dp)
+        val minIconSpacePx = (17 * density).toInt() // 34px (17dp)
+        val maxIconSpacePx = (70 * density).toInt() // 140px (70dp)
+        val navButtonsLayoutWidthPx = (180 * density).toInt() // 360px (180dp)
+
+        // --- PORTRAIT (600x960dp, 3-Button Nav) ---
+        // taskbar_button_margin_6_5 = 75dp
+        val portraitAvailableWidthPx = (600 * density).toInt() // 1200px
+        val portraitInlineMarginPx = (75 * density).toInt() // 150px (75dp)
+        val portraitBarEndOffset = navButtonsLayoutWidthPx + portraitInlineMarginPx // 510px (255dp)
+        val portraitSideSpacePx = portraitInlineMarginPx // 150px (75dp)
+        val portraitMaxHotseatIconsWidthPx =
+            portraitAvailableWidthPx - portraitSideSpacePx - portraitBarEndOffset // 540px (270dp)
+
+        // Simulate HotseatProfile.kt icon reduction loop:
+        var portraitIcons = 6
+        var portraitBorderSpace: Int
+        do {
+            portraitIcons--
+            val numBorders = portraitIcons // numShown - 1 + 1 (extra border next to nav buttons)
+            val totalIconPx = iconSizePx * portraitIcons
+            portraitBorderSpace =
+                kotlin.math.min((portraitMaxHotseatIconsWidthPx - totalIconPx) / numBorders, maxIconSpacePx)
+        } while (portraitBorderSpace < minIconSpacePx && portraitIcons > 1)
+
+        // Pre-normalization portrait icon count is 3
+        assertThat(portraitIcons).isEqualTo(3)
+        // 540px - 360px = 180px; 180px / 3 = 60px (30dp >= 17dp)
+        assertThat(portraitBorderSpace).isEqualTo(60)
+
+        // --- LANDSCAPE (960x600dp, 3-Button Nav) ---
+        // values-land taskbar_button_margin_6_5 = 219.6dp
+        val landscapeAvailableWidthPx = (960 * density).toInt() // 1920px
+        val landscapeInlineMarginPx = (219.6f * density).toInt() // 439px (~219.6dp)
+        val landscapeBarEndOffset = navButtonsLayoutWidthPx + landscapeInlineMarginPx // 799px (~399.6dp)
+        val landscapeSideSpacePx = landscapeInlineMarginPx // 439px (~219.6dp)
+        val landscapeMaxHotseatIconsWidthPx =
+            landscapeAvailableWidthPx - landscapeSideSpacePx - landscapeBarEndOffset // 682px (~340.8dp)
+
+        var landscapeIcons = 6
+        var landscapeBorderSpace: Int
+        do {
+            landscapeIcons--
+            val numBorders = landscapeIcons
+            val totalIconPx = iconSizePx * landscapeIcons
+            landscapeBorderSpace =
+                kotlin.math.min((landscapeMaxHotseatIconsWidthPx - totalIconPx) / numBorders, maxIconSpacePx)
+        } while (landscapeBorderSpace < minIconSpacePx && landscapeIcons > 1)
+
+        // Pre-normalization landscape icon count is 4
+        assertThat(landscapeIcons).isEqualTo(4)
+        // 682px - 480px = 202px; 202px / 4 = 50px (25dp >= 17dp)
+        assertThat(landscapeBorderSpace).isEqualTo(50)
+
+        // --- NORMALIZATION in InvariantDeviceProfile.java ---
+        // numMinShownHotseatIconsForTablet = min(portrait, landscape) = min(3, 4) = 3
+        val normalizedTabletIcons = kotlin.math.min(portraitIcons, landscapeIcons)
+        assertThat(normalizedTabletIcons).isEqualTo(3)
+    }
