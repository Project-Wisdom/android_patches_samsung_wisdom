+/**
+ * Phase 2A regression and capacity tests verifying that:
+ * 1. Compact tablets (~600dp) select `tablet_compact` on fresh install.
+ * 2. Large tablets (~900x820dp) select `tablet_normal` on fresh install.
+ * 3. `tablet_compact` does not have inline QSB, avoiding hotseat/taskbar icon capacity reduction.
+ * 4. Start-align behaviors remain strictly isolated without boolean OR interpolation leakage.
+ */
+@SmallTest
+@RunWith(AndroidJUnit4::class)
+class CompactTabletDeviceProfileTest : AbstractDeviceProfileTest() {
+
+    @Test
+    fun freshInstall_smallTabletSelectsTabletCompact() {
+        val compactSpec = deviceSpecs["compact-tablet"]!!
+        // Fresh install has no GRID_NAME set (gridName = null)
+        initializeVarsForTablet(
+            deviceSpec = compactSpec,
+            isLandscape = false,
+            isGestureMode = false,
+            gridName = null,
+        )
+        val idp = context.appComponent.idp
+        val dp = idp.getDeviceProfile(context)
+
+        assertThat(dp.deviceProperties.isLargeScreen).isTrue()
+        assertThat(idp.numColumns).isEqualTo(6)
+        assertThat(idp.numRows).isEqualTo(5)
+
+        // Verifies the closest default grid picked by InvariantDeviceProfile is tablet_compact
+        val selectedGrid = context.appComponent.launcherPrefs.get(GRID_NAME)
+        assertThat(selectedGrid).isEqualTo("tablet_compact")
+        assertThat(context.appComponent.launcherPrefs.get(COMPACT_TABLET_GRID_MIGRATION_V1_LOCAL_CHECKED)).isTrue()
+    }
+
+    @Test
+    fun freshInstall_largeTabletSelectsTabletNormal() {
+        val largeSpec = deviceSpecs["tablet"]!!
+        // Fresh install on large tablet (gridName = null)
+        initializeVarsForTablet(
+            deviceSpec = largeSpec,
+            isLandscape = true,
+            isGestureMode = false,
+            gridName = null,
+        )
+        val idp = context.appComponent.idp
+        val dp = idp.getDeviceProfile(context)
+
+        assertThat(dp.deviceProperties.isLargeScreen).isTrue()
+        assertThat(idp.numColumns).isEqualTo(6)
+        assertThat(idp.numRows).isEqualTo(5)
+
+        // Verifies large tablet keeps tablet_normal
+        val selectedGrid = context.appComponent.launcherPrefs.get(GRID_NAME)
+        assertThat(selectedGrid).isEqualTo("tablet_normal")
+        // Critical: backedUp marker must remain false so cloud backups don't suppress compact-tablet evaluation
+        assertThat(context.appComponent.launcherPrefs.get(COMPACT_TABLET_GRID_MIGRATION_V1)).isFalse()
+        assertThat(context.appComponent.launcherPrefs.get(COMPACT_TABLET_GRID_MIGRATION_V1_LOCAL_CHECKED)).isTrue()
+    }
+
+    @Test
+    fun tabletCompact_landscapeAndPortrait_profileMetricsAndCapacity() {
+        val compactSpec = deviceSpecs["compact-tablet"]!!
+
+        // --- LANDSCAPE (3-Button Navigation) ---
+        initializeVarsForTablet(
