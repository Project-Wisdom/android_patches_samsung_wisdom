+    # SM-P205 can retain a legacy Android data tree whose security.sehash
+    # causes the recursive pass above to skip /data entirely.  Re-apply the
+    # exact platform labels needed before derive_classpath, odsign and
+    # installd; these are all standard platform paths and the operation is
+    # idempotent on devices that already have the correct labels.
+    restorecon_recursive --force /data/system/environ
+    restorecon_recursive --force /data/misc/installd
+    restorecon_recursive --force /data/misc/odsign
+    restorecon_recursive --force /data/misc/odsign/metrics
+    restorecon_recursive --force /data/misc/surfaceflinger
+    # The SM-P205 userdata tree predates the current Bluetooth data types.
+    # Run this from platform init: vendor_init is intentionally not allowed
+    # to relabel system_data_file directories.
+    restorecon_recursive --force /data/misc/bluedroid
+    restorecon_recursive --force /data/misc/bluetooth
