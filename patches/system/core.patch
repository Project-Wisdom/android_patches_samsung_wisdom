diff --git a/init/fscrypt_init_extensions.cpp b/init/fscrypt_init_extensions.cpp
index 6a561e54cc694cc7048d960969c1b0a976d804e8..3c46f82e521a875c24125f3fb3be1092a754c7ae 100644
--- a/init/fscrypt_init_extensions.cpp
+++ b/init/fscrypt_init_extensions.cpp
@@ -34,12 +34,50 @@
 #include <cutils/properties.h>
 #include <cutils/sockets.h>
 #include <fscrypt/fscrypt.h>
+#include <keyutils.h>
 #include <logwrap/logwrap.h>
+#include <sys/syscall.h>
 
 #define TAG "fscrypt"
 
 using namespace android::fscrypt;
 
+bool FscryptInstallKeyring() {
+    key_serial_t device_keyring =
+            keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0);
+    if (device_keyring == -1) {
+        if (syscall(__NR_keyctl, KEYCTL_JOIN_SESSION_KEYRING, nullptr) == -1) {
+            PLOG(ERROR) << "Failed to join session keyring";
+            return false;
+        }
+
+        device_keyring = add_key("keyring", "fscrypt", 0, 0, KEY_SPEC_SESSION_KEYRING);
+        if (device_keyring == -1) {
+            PLOG(ERROR) << "Failed to create fscrypt keyring";
+            return false;
+        }
+    } else {
+        LOG(INFO) << "fscrypt keyring is already created";
+    }
+
+    // All descendants need to search for fscrypt keys, but only the root-owned
+    // init/vold path needs to add or remove them.  A child possessing this
+    // session keyring must not gain write, link, or setattr rights.  Init
+    // retains owner setattr so later mount_all calls can reapply this mask.
+    constexpr uint32_t kFscryptKeyringPerms =
+            KEYUTILS_POS_SEARCH | KEYUTILS_USR_VIEW | KEYUTILS_USR_WRITE |
+            KEYUTILS_USR_SEARCH | KEYUTILS_USR_SETATTR;
+    if (syscall(__NR_keyctl, KEYCTL_SETPERM, device_keyring, kFscryptKeyringPerms) == -1) {
+        // The kernel default gives every inheriting possessor write access.
+        // Never continue booting with that broader permission mask.
+        PLOG(FATAL) << "Failed to restrict permissions on fscrypt keyring";
+    }
+
+    LOG(INFO) << "fscrypt keyring created with id " << device_keyring << " in process "
+              << getpid();
+    return true;
+}
+
