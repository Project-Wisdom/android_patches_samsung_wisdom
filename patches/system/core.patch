+#ifndef _KEYUTILS_H_
+#define _KEYUTILS_H_
+
+#include <linux/keyctl.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+
+typedef int32_t key_serial_t;
+
+// Linux key permission bits.  The kernel-only <linux/key.h> defines these,
+// but the userspace UAPI header does not.  Possessor rights also apply to
+// processes that inherit a session keyring from init.
+#define KEYUTILS_POS_SEARCH 0x08000000u
+#define KEYUTILS_USR_VIEW 0x00010000u
+#define KEYUTILS_USR_WRITE 0x00040000u
+#define KEYUTILS_USR_SEARCH 0x00080000u
+#define KEYUTILS_USR_SETATTR 0x00200000u
+
+key_serial_t add_key(const char* type, const char* description, const void* payload,
+                     size_t payload_length, key_serial_t ring_id);
+
+long keyctl_search(key_serial_t ring_id, const char* type, const char* description,
+                   key_serial_t dest_ring_id);
+
+long keyctl_unlink(key_serial_t key, key_serial_t keyring);
+
+__END_DECLS
+
+#endif
