+// Android 17 supports the filesystem key-management ioctls, but this device's
+// 4.4 kernel only has the older global keyring interface.  Keep the probe local
+// and use the legacy path only for v1 policies, which remain compatible with
+// this kernel's on-disk format.
+static bool isFsKeyringSupported() {
+    static bool initialized = false;
+    static bool supported = false;
+
+    if (initialized) return supported;
+
+    android::base::unique_fd fd(open("/data", O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (fd == -1) {
+        PLOG(ERROR) << "Failed to open /data while probing fscrypt key ioctls";
+        initialized = true;
+        return false;
+    }
+
+    errno = 0;
+    (void)ioctl(fd, FS_IOC_ADD_ENCRYPTION_KEY, nullptr);
+    if (errno == ENOTTY) {
+        LOG(INFO) << "Kernel lacks FS_IOC_ADD_ENCRYPTION_KEY; using the legacy fscrypt keyring";
+    } else {
+        if (errno != EFAULT) {
+            PLOG(WARNING) << "Unexpected fscrypt key ioctl probe result";
+        }
+        supported = true;
+    }
+    initialized = true;
+    return supported;
+}
